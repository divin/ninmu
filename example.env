# Ninmu environment variables

# Vikunja instance and API token (required)
# Create a token in Vikunja: Settings → API Tokens
VIKUNJA_URL=https://vikunja.example
VIKUNJA_TOKEN=your_vikunja_api_token_here

# NoteDiscovery instance (required) and API key (optional)
# The key comes from NoteDiscovery's config.yaml (authentication.api_key).
# Leave it empty if your NoteDiscovery instance runs without authentication.
NOTEDISCOVERY_URL=http://notes.example:8000
# NOTEDISCOVERY_API_KEY=your_notediscovery_api_key_here

# Optional: Bearer token for MCP server auth. When set, clients must send
# "Authorization: Bearer <token>" on every request. Leave unset for an open
# server (acceptable on a trusted local network).
# NINMU_AUTH_TOKEN=your_auth_token_here

# Optional: page-size defaults for list tools (default: 20, hard max: 100)
# LIST_DEFAULT_LIMIT=20
# LIST_MAX_LIMIT=100

# Optional: Comma-separated list of browser origins allowed to call the server
# via CORS (needed for browser-based MCP clients). Default: allow all origins.
# CORS_ORIGINS=https://my-ui.example.com

# Optional: Host port for the Docker deployment (default: 9093)
# NINMU_PORT=9093
